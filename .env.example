# Memibrium — Environment Variables
# Copy to .env and fill in values. server.py does NOT load .env itself; export it first:
#   set -a; . ./.env; set +a; python server.py
# Full list and defaults: docs/operations.md#environment-variables

# ── Embeddings / chat / SLM (OpenAI-compatible, keyless; Ollama by default) ──
# Every non-Azure client sends the fixed API key "ollama"; there is no key variable.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Must equal the model's output width (nomic-embed-text: 768). Fixed at table creation.
EMBEDDING_DIM=768
OLLAMA_CHAT_BASE=http://localhost:11434/v1
CHAT_MODEL=gemma4:e4b
SLM_BASE_URL=http://localhost:11434/v1
SLM_MODEL=qwen2.5:0.5b

# ── PostgreSQL (with pgvector or ruvector extension) ──────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memory
DB_USER=memory
DB_PASSWORD=memory

# ── RuVector (Phase 2.5 — GNN re-ranking + SONA self-learning) ───
USE_RUVECTOR=false
RUVECTOR_GNN=true

# ── LEANN (Phase 3 — cold tier compression) ───────────────────────
USE_LEANN=false
LEANN_INDEX_DIR=./data/leann

# ── CT Parameters ─────────────────────────────────────────────────
IMPORTANCE_THRESHOLD=0.4
SHEDDING_THRESHOLD=0.05
CONSOLIDATE_INTERVAL_MIN=30

# ── Ingestion Engine (read in ingest_engine.py) ───────────────────
INGEST_MAX_CHUNK_CHARS=2000
INGEST_MIN_CHUNK_CHARS=100
INGEST_OVERLAP_CHARS=200

# ── MCP endpoint (POST /mcp) ──────────────────────────────────────
# Directories (os.pathsep-separated: ':' on Linux/macOS, ';' on Windows) that agents may ingest from over
# MCP. Absolute paths only (relative entries are ignored with a warning). Unset = ingest_file, ingest_directory,
# ingest_jsonl and compile_wiki are not served over MCP.
# MCP_INGEST_ROOTS=/path/to/notes:/path/to/exports

# ── Cross-site request refusal (MED-271) ──────────────────────────
# Browser origins (comma-separated scheme://host[:port]) whose requests to the state-changing routes are let
# through, e.g. a console served same-origin behind a reverse proxy. This does NOT enable browser CORS: there is
# no OPTIONS preflight and no CORS headers, so other-origin pages still cannot send JSON or read replies.
# Unset = any request carrying an Origin header to a non-GET route gets 403. Never applies to POST /mcp.
# Not authentication (MED-234).
# MEMIBRIUM_ALLOWED_ORIGINS=http://localhost:3000

# ── Host allowlist, DNS-rebinding refusal (MED-276) ──────────────
# Host names (comma-separated, no port) accepted in the Host header on every route, GETs included, in addition
# to localhost, 127.0.0.1 and ::1 (always accepted, any port). Any other Host gets 421 Misdirected Request.
# Add the names real clients use: the compose service name for another container, a LAN/Tailscale name, or the
# public name a reverse proxy forwards. Not authentication (MED-234).
# MEMIBRIUM_ALLOWED_HOSTS=memibrium

# ── Compose stack only (docker-compose.ruvector.yml; server.py does not read these) ──
# OLLAMA_MODELS=nomic-embed-text      # pull exactly these; unset = EMBEDDING_MODEL + CHAT_MODEL + SLM_MODEL
# MEMIBRIUM_BIND=127.0.0.1            # host address for the published ports; /mcp/* has no auth (MED-234)

# Azure OpenAI / Foundry variables are legacy (subscription closed 2026-11-02); leave unset.
