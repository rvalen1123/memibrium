# AZURE_GATEWAY_API_KEY must be set in Caddy's environment (e.g. /etc/caddy/caddy.env, EnvironmentFile=
# in the systemd unit). It was previously committed here in plain text; that key must be rotated.
leann-memory-prod.southcentralus.cloudapp.azure.com {
  handle /mcp* {
    reverse_proxy 127.0.0.1:8787
  }
  handle /health {
    reverse_proxy 127.0.0.1:8787
  }
  handle {
    respond "Always-On Memory Server v2" 200
  }
}

http://:9999 {
  reverse_proxy https://azuregateway.azure-api.net {
    header_up api-key {$AZURE_GATEWAY_API_KEY}
    header_up Host azuregateway.azure-api.net
    transport http {
      tls
    }
  }
}
